# WebSocket Tunnel Server - Docker Image
FROM golang:1.21-alpine AS builder

WORKDIR /app

# 复制依赖文件
COPY go.mod go.sum ./
RUN go mod download

# 复制源码
COPY ws-tunnel-to-haproxy.go ./

# 编译
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o ws-tunnel-server ws-tunnel-to-haproxy.go

# 最终镜像
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# 从构建阶段复制二进制文件
COPY --from=builder /app/ws-tunnel-server .

# 暴露端口
EXPOSE 8080

# 默认参数
ENV LISTEN_PORT=8080
ENV WS_PATH=/mm
ENV HAPROXY_IP=3.3.3.3
ENV HAPROXY_PORT=20001
ENV PASSWORD=change_me

ENTRYPOINT ["./ws-tunnel-server"]
CMD ["-listen", ":8080", "-path", "/mm", "-haproxy-ip", "3.3.3.3", "-haproxy-port", "20001", "-password", "change_me"]
