# WebSocket Tunnel Client - Docker Image
FROM golang:1.21-alpine AS builder

WORKDIR /app

# 复制依赖文件
COPY go.mod go.sum ./
RUN go mod download

# 复制源码
COPY ws-tunnel-client.go ./

# 编译
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o ws-tunnel-client ws-tunnel-client.go

# 最终镜像
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# 从构建阶段复制二进制文件
COPY --from=builder /app/ws-tunnel-client .

# 暴露端口
EXPOSE 1080

# 默认参数
ENV LOCAL_ADDR=0.0.0.0:1080
ENV SERVER_ADDR=ws://2.2.2.2:8080/mm
ENV PASSWORD=change_me

ENTRYPOINT ["./ws-tunnel-client"]
CMD ["-local", "0.0.0.0:1080", "-server", "ws://2.2.2.2:8080/mm", "-password", "change_me"]
